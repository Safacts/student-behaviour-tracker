# Environment Configuration Example
# Copy this file to .env and update with your actual values

# Application Settings
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/student_behavior
SQLITE_URL=sqlite:///./data/student_behavior.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
CACHE_TTL=3600
SESSION_TTL=86400

# AI/ML Configuration
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.5-flash
LANGCHAIN_VERBOSE=false
LANGCHAIN_DEBUG=false
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT=300
BEHAVIOR_ANALYSIS_THRESHOLD=0.7
PREDICTION_CONFIDENCE_THRESHOLD=0.8

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_TITLE=Student Behavior Analytics API
API_DESCRIPTION=Production-grade student behavior analytics with agentic AI
API_VERSION=1.0.0
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
CORS_ORIGINS=["*"]
CORS_METHODS=["*"]
CORS_HEADERS=["*"]
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days
INCLUDE_REQUEST_ID=true
INCLUDE_TIMESTAMP=true

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics
HEALTH_CHECK_INTERVAL=30
ENABLE_TRACING=false
SAMPLING_RATE=0.1

# Feature Flags
ENABLE_CACHING=true
ENABLE_ASYNC_PROCESSING=true
ENABLE_WEBHOOKS=true

# Docker/Production Settings
RUN_MIGRATIONS=false
